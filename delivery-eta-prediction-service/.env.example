# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/HERE

# Feast Configuration
FEAST_REPO_PATH=feature_repo/

# Airflow User ID (for file permissions)
AIRFLOW_UID=50000

# =====================================================
# SECURITY: REQUIRED CREDENTIALS (CHANGE ALL VALUES!)
# =====================================================

# PostgreSQL Database Credentials
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=airflow

# Airflow Fernet Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here

# Airflow Admin Credentials
AIRFLOW_ADMIN_USERNAME=your_admin_username
AIRFLOW_ADMIN_PASSWORD=your_secure_admin_password

# Grafana Admin Password
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password

# API CORS Configuration (comma-separated list of allowed origins)
# For production, set to your actual frontend domain(s)
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
